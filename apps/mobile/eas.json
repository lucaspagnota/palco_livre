{
  "cli": {
    "version": ">= 18.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "channel": "preview"
    },
    "production": {
      "android": {
        "image": "latest"
      },
      "channel": "production"
    }
  }
}
